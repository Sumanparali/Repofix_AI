REPOFIX_ANALYSIS_ONLY=1

# PostgreSQL
POSTGRES_DB=repofix
POSTGRES_USER=repofix
POSTGRES_PASSWORD=change-this-password

# Use Firebase for authenticated deployments.
REPOFIX_AUTH_MODE=firebase
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=

# Path inside the API container to a read-only Firebase service-account JSON file.
GOOGLE_APPLICATION_CREDENTIALS=
