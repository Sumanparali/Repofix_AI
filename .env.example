REPOFIX_ANALYSIS_ONLY=0
REPOFIX_AI_PROVIDER=gemini
REPOFIX_MODEL=gemini-3.8-flash
GEMINI_API_KEY=
REPOFIX_ALLOW_REPAIR=0

# PostgreSQL
POSTGRES_DB=repofix
POSTGRES_USER=repofix
POSTGRES_PASSWORD=change-this-password

# Use Firebase for authenticated deployments.
REPOFIX_AUTH_MODE=firebase
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=

# Path inside the API container to a read-only Firebase service-account JSON file.
GOOGLE_APPLICATION_CREDENTIALS=
